<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Red: solo para descargar los datos de Mallorca (y en H5, incidencias). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ubicación en primer plano (GPS_PROVIDER, sin Google Play Services). Sin ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Descarga larga de mapas con WorkManager en primer plano y su notificación de progreso. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Conducción: servicio en primer plano de ubicación arrancado por el usuario (Empezar/Conducir). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Órdenes de voz al copiloto (Vosk, sin red): solo se graba al pulsar el micrófono o con «Copiloto» activado. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Escucha de «Copiloto» con la pantalla apagada: el servicio de conducción añade el tipo micrófono. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Casco: la voz y el micrófono pasan por el intercom Bluetooth (canal de comunicación SCO). BLUETOOTH_CONNECT se pide
         en tiempo de ejecución desde Android 12; si se deniega, todo sigue por el altavoz y el micrófono del móvil. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".RallyCopilotApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.RallyCopilot">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RallyCopilot.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Atajos del icono (mantener pulsado): «Conducir libre» y «Repetir último tramo». -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!--
                GPX y KML recibidos de otras apps («Abrir con» y «Compartir»), solo como content:// y solo para importarlos
                como tramos: la app no lee nada fuera del Uri recibido y rechaza lo que pase de 20 MB. Los .gpx/.kml con
                tipo genérico (octet-stream) se reconocen por la extensión del Uri.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\.kml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Widget «Última salida» de la pantalla de inicio: lo actualiza el sistema (30 min) y la app al cerrarse. -->
        <receiver
            android:name=".ui.widget.WidgetUltimaSalida"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ultima_salida" />
        </receiver>

        <!--
            Compartir un tramo como GPX por el menú de Android: el archivo se escribe en cache/compartir/ y se entrega con un
            permiso temporal de lectura. No está exportado y no sirve nada más que esa carpeta.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.compartir"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager se inicializa con HiltWorkerFactory (RallyCopilotApplication es Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name=".data.navegacion.ServicioNavegacion"
            android:exported="false"
            android:foregroundServiceType="location|microphone" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
