<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Solo debug: mide el enrutador desde adb. Exige DUMP, que solo tiene el shell de adb. -->
        <receiver
            android:name=".debug.RutaDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.trombito.rallycopilot.dev.DEBUG_RUTA" />
            </intent-filter>
        </receiver>
        <!-- Solo debug: galería de iconos y banners de maniobra. exported=true porque el shell de adb no puede
             lanzar actividades no exportadas de otra app; no existe en release. -->
        <activity
            android:name=".debug.GaleriaManiobrasActivity"
            android:exported="true" />
    </application>
</manifest>
